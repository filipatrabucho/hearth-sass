# ─── Frontend (Vite expõe estas ao browser — nunca metas segredos aqui) ───
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Slug do workspace mostrado no site público (/, /regras, /equipa, /suporte…)
# enquanto não há subdomain routing real (slug.hearth.gg). Se não definires,
# mostra o primeiro workspace criado.
VITE_PUBLIC_WORKSPACE_SLUG=

# Client ID da app Discord — usado para gerar o link de convite do bot no
# onboarding (discord.com/developers/applications → OAuth2 → Client ID).
VITE_DISCORD_CLIENT_ID=

# ─── Netlify Functions (só correm no servidor, nunca chegam ao browser) ───
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SITE_URL=http://localhost:5173

# Resend (opcional) — para o formulário de /suporte enviar email além de
# guardar o pedido na BD. Sem isto, o pedido fica só visível no dashboard.
RESEND_API_KEY=
SUPPORT_TO_EMAIL=
SUPPORT_FROM_EMAIL=onboarding@resend.dev
